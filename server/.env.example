# Tip:
# - Local dev (recommended): copy .env.local.example -> .env
# - Local Windows + PostgreSQL: copy .env.windows-postgres.example -> .env
# - Production (CentOS + PostgreSQL): copy .env.prod.example -> .env

PORT=3000
DB_PATH=./data/tongxing.db
# DB_CLIENT: sqljs (default) | postgres
DB_CLIENT=sqljs
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/tongxing
# or use PG* fields:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=tongxing
# PGPASSWORD=strong-password
# PGDATABASE=tongxing
# PGSSLMODE=disable
TOKEN_TTL_HOURS=168
PUBLIC_BASE_URL=http://localhost:3000

# WeChat login mode: mock | real
WECHAT_LOGIN_MODE=mock
WECHAT_APPID=
WECHAT_SECRET=

# Security moderation
WECHAT_SECURITY_ENABLED=false
CUSTOM_BLOCKED_WORDS=

# COS storage (optional)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

# Admin auth security
ADMIN_JWT_SECRET=replace-with-very-strong-secret
ADMIN_JWT_EXPIRES_IN=12h

# Optional: create first admin account automatically at startup
# Password rule: 10+ chars with upper/lower/number/symbol
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=ReplaceMe!123

# Optional legacy fallback token for scripts (not recommended)
ADMIN_TOKEN=

# Activity/online stats tuning
ONLINE_WINDOW_MINUTES=5
USER_ACTIVITY_TRACK_INTERVAL_MS=60000
