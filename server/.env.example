PORT=3000
DB_PATH=./data/tongxing.db
TOKEN_TTL_HOURS=168
PUBLIC_BASE_URL=http://localhost:3000

# WeChat login mode: mock | real
WECHAT_LOGIN_MODE=mock
WECHAT_APPID=
WECHAT_SECRET=

# Security moderation
WECHAT_SECURITY_ENABLED=false
CUSTOM_BLOCKED_WORDS=

# COS storage (optional)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

# Admin API token (required to call /api/admin/*)
ADMIN_TOKEN=replace-with-strong-token
