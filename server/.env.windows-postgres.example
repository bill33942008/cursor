## Local Windows template (connect to PostgreSQL)
## Prerequisite: PostgreSQL service is running locally or reachable by network.
## If startup reports pg-native missing, install:
## - PostgreSQL (with pg_config in PATH)
## - Visual Studio Build Tools (C++ workload)
## - Python3
## Then run: npm install

PORT=3000
DB_CLIENT=postgres
DATABASE_URL=postgres://tongxing:replace-me-strong@127.0.0.1:5432/tongxing
# Or use PG split fields instead of DATABASE_URL:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=tongxing
# PGPASSWORD=replace-me-strong
# PGDATABASE=tongxing
# PGSSLMODE=disable

TOKEN_TTL_HOURS=168
PUBLIC_BASE_URL=http://localhost:3000

# WeChat login mode: mock | real
WECHAT_LOGIN_MODE=mock
WECHAT_APPID=
WECHAT_SECRET=

# Security moderation
WECHAT_SECURITY_ENABLED=false
CUSTOM_BLOCKED_WORDS=

# COS storage (optional)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

# Admin auth security
ADMIN_JWT_SECRET=replace-with-very-strong-secret
ADMIN_JWT_EXPIRES_IN=12h

# Optional: create first admin account automatically at startup
# Password rule: 10+ chars with upper/lower/number/symbol
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=ReplaceMe!123

# Optional legacy fallback token for scripts (not recommended)
ADMIN_TOKEN=

# Activity/online stats tuning
ONLINE_WINDOW_MINUTES=5
USER_ACTIVITY_TRACK_INTERVAL_MS=60000
