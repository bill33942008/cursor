.profile-card {
  margin-bottom: 16rpx;
}

.profile-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  text-align: center;
  line-height: 84rpx;
  font-size: 34rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff4b66 0%, #ff2442 100%);
  box-shadow: 0 10rpx 20rpx rgba(255, 71, 98, 0.3);
}

.name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.id-text {
  display: block;
  margin-top: 6rpx;
}

.apply-btn {
  margin-top: 6rpx;
  height: 66rpx;
  line-height: 66rpx;
  padding: 0 24rpx;
}

.empty-state {
  padding: 12rpx 0;
}

.request-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.request-name,
.friend-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.request-id {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
}

.request-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.friend-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.friend-avatar {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  text-align: center;
  line-height: 62rpx;
  font-size: 26rpx;
  color: #ff2442;
  background: #fff2f4;
}
