.profile-page {
  padding-top: 12rpx;
}

.skeleton-header {
  height: 80rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.skeleton-line-wide {
  height: 22rpx;
  border-radius: 10rpx;
  width: 100%;
  margin-bottom: 8rpx;
}

.skeleton-line-mid {
  height: 22rpx;
  border-radius: 10rpx;
  width: 68%;
}

.profile-header {
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fff6f8 100%);
  box-shadow: 0 10rpx 32rpx rgba(20, 31, 56, 0.08);
}

.profile-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  text-align: center;
  line-height: 90rpx;
  font-size: 34rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff4b66 0%, #ff2442 100%);
}

.profile-main .subtitle {
  margin-top: 6rpx;
  display: block;
}

.name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.profile-id {
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-item {
  flex: 1;
  background: #fff;
  border: 2rpx solid #f2e5e8;
  border-radius: 16rpx;
  text-align: center;
  padding: 14rpx 0;
}

.stat-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #ff2442;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #667085;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.friend-input {
  flex: 1;
}

.add-btn {
  width: 138rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.empty-state {
  padding: 12rpx 0;
}

.request-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.request-left {
  display: flex;
  align-items: center;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #ff2442;
}

.request-name,
.friend-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.request-id {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
}

.request-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.menu-icon {
  width: 40rpx;
  margin-right: 10rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.menu-arrow {
  font-size: 28rpx;
  color: #98a2b3;
}

.action-btn {
  min-width: 96rpx;
}

.friend-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.friend-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: linear-gradient(135deg, #ffd5dc 0%, #ffc2cc 100%);
}

.friend-main {
  flex: 1;
}
