<view class="page-wrap profile-page">
  <view wx:if="{{loading}}" class="card">
    <view class="skeleton skeleton-header"></view>
    <view class="skeleton skeleton-line-wide"></view>
    <view class="skeleton skeleton-line-mid"></view>
  </view>

  <block wx:if="{{!loading}}">
  <view class="profile-header" wx:if="{{user}}">
    <view class="profile-head">
      <view class="avatar">
        <image wx:if="{{user.avatarUrl}}" class="avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
        <text wx:else>{{userInitial}}</text>
      </view>
      <view class="profile-main">
        <text class="name">{{user.nickname}}</text>
        <text class="subtitle">同行账号</text>
      </view>
    </view>
    <view class="profile-id">
      <text class="muted">用户ID：{{user.id}}</text>
    </view>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{friends.length}}</text>
        <text class="stat-label">好友</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{incomingRequests.length}}</text>
        <text class="stat-label">申请</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">设置与安全</view>
    <view class="menu-item pressable" hover-class="pressable-hover" bindtap="goTimelineManage">
      <text class="menu-icon">🗺️</text>
      <text class="menu-text">我的时间线</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item pressable" hover-class="pressable-hover" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置中心</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item pressable" hover-class="pressable-hover" bindtap="goPrivacy">
      <text class="menu-icon">🔒</text>
      <text class="menu-text">隐私设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item pressable" hover-class="pressable-hover" bindtap="goSecurity">
      <text class="menu-icon">🛡️</text>
      <text class="menu-text">账号安全</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">收到的申请</view>
    <block wx:if="{{incomingRequests.length === 0}}">
      <view class="empty-state">
        <text class="subtitle">暂无申请</text>
      </view>
    </block>
    <block wx:for="{{incomingRequests}}" wx:key="id">
      <view class="request-item pressable" hover-class="pressable-hover" data-id="{{item.fromUserId}}" bindtap="openUserProfile">
        <view class="request-left">
          <view class="dot"></view>
          <view>
            <text class="request-name">{{item.fromNickname}}</text>
            <text class="subtitle request-id">{{item.fromUserId}}</text>
            <text wx:if="{{item.message}}" class="request-msg">{{item.message}}</text>
          </view>
        </view>
        <view class="request-actions">
          <button class="icon-btn action-btn" size="mini" hover-class="pressable-hover" data-id="{{item.id}}" data-action="accept" catchtap="handleRequest">同意</button>
          <button class="btn-ghost action-btn" size="mini" hover-class="pressable-hover" data-id="{{item.id}}" data-action="reject" catchtap="handleRequest">拒绝</button>
        </view>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="section-title">我发出的申请</view>
    <block wx:if="{{outgoingRequests.length === 0}}">
      <view class="empty-state">
        <text class="subtitle">暂无待处理申请</text>
      </view>
    </block>
    <block wx:for="{{outgoingRequests}}" wx:key="id">
      <view class="request-item">
        <view class="request-left">
          <view class="dot soft-dot"></view>
          <view>
            <text class="request-name">{{item.toNickname}}</text>
            <text class="subtitle request-id">{{item.toUserId}}</text>
            <text wx:if="{{item.message}}" class="request-msg">{{item.message}}</text>
          </view>
        </view>
        <view class="request-actions">
          <button class="btn-ghost action-btn" size="mini" hover-class="pressable-hover" data-id="{{item.id}}" bindtap="revokeRequest">撤回</button>
        </view>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="section-title">我的好友（{{friends.length}}）</view>
    <block wx:if="{{friends.length === 0}}">
      <view class="empty-state">
        <text class="subtitle">还没有好友，去广场认识新朋友吧</text>
      </view>
    </block>
    <block wx:for="{{friends}}" wx:key="id">
      <view class="friend-item pressable" hover-class="pressable-hover" data-id="{{item.id}}" bindtap="openUserProfile">
        <view class="friend-avatar"></view>
        <view class="friend-main">
          <text class="friend-name">{{item.nickname}}</text>
          <text class="subtitle request-id">{{item.id}}</text>
        </view>
      </view>
    </block>
  </view>
  </block>
</view>
