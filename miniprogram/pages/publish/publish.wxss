.form-card {
  padding-bottom: 30rpx;
}

.content-box {
  margin-bottom: 8rpx;
}

.content-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.picker-box,
.input-box {
  margin-bottom: 14rpx;
}

.anonymous-row {
  margin: 8rpx 0 24rpx;
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  background: #f8f9fc;
  border: 2rpx solid #edf0f5;
}

.anonymous-title {
  margin-bottom: 6rpx;
  font-size: 28rpx;
}

.media-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rpx;
  margin-bottom: 10rpx;
}

.media-title {
  margin-bottom: 0;
  line-height: 1;
}

.media-empty {
  margin-left: 2rpx;
  margin-right: 2rpx;
  margin-bottom: 10rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f8f9fc;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-left: 2rpx;
  margin-right: 2rpx;
  margin-bottom: 20rpx;
}

.media-item {
  border-radius: 16rpx;
  overflow: hidden;
  background: #f8fafc;
  border: 2rpx solid #eef1f6;
}

.media-thumb {
  width: 100%;
  height: 220rpx;
  display: block;
  background: #e5e7eb;
}

.media-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx;
}

.media-status {
  font-size: 21rpx;
  color: #667085;
}

.remove-btn {
  height: 50rpx;
  line-height: 50rpx;
  padding: 0 16rpx;
  font-size: 21rpx;
}

.submit-btn {
  margin-top: 8rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}
