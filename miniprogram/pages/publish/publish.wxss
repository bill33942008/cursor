.form textarea {
  width: 100%;
  height: 220rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 10rpx;
  margin-bottom: 18rpx;
}

.form input {
  background: #f8fafc;
  padding: 16rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.picker {
  background: #f8fafc;
  padding: 16rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.anonymous-tip {
  display: block;
  color: #6b7280;
  margin: 10rpx 0 20rpx;
  font-size: 24rpx;
}

.media-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.media-item {
  background: #f8fafc;
  border-radius: 10rpx;
  padding: 12rpx;
  margin-bottom: 10rpx;
}

.media-url {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  word-break: break-all;
  margin: 8rpx 0;
}
