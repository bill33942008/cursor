.profile-header {
  border-radius: 24rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(20, 31, 56, 0.08);
}

.profile-head {
  display: flex;
  align-items: center;
}

.avatar-image,
.avatar-placeholder {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.avatar-placeholder {
  text-align: center;
  line-height: 86rpx;
  font-size: 34rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff4b66 0%, #ff2442 100%);
}

.profile-main {
  flex: 1;
}

.name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.profile-id {
  margin-top: 10rpx;
}

.summary-row {
  margin-top: 12rpx;
}

.profile-actions {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.action-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
}

.note-row {
  margin-top: 12rpx;
}

.note-input {
  min-height: 76rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.timeline-list {
  padding-left: 12rpx;
}

.timeline-item {
  position: relative;
  padding-left: 26rpx;
  margin-bottom: 14rpx;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 20rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff2442;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 34rpx;
  bottom: -14rpx;
  width: 2rpx;
  background: #ffd3db;
}

.timeline-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 31, 56, 0.08);
}

.event-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.event-note {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #475467;
}

.timeline-media-wrap {
  margin-top: 10rpx;
}

.timeline-cover-media {
  width: 100%;
  height: 210rpx;
  border-radius: 12rpx;
  background: #f2f4f8;
}

.timeline-thumb-row {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.timeline-thumb-item {
  position: relative;
}

.timeline-thumb-media {
  width: 100%;
  height: 98rpx;
  border-radius: 12rpx;
  background: #f2f4f8;
}

.timeline-more-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 12rpx;
  background: rgba(2, 6, 23, 0.52);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-posts {
  padding: 6rpx 0 12rpx;
}

.post-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.post-content {
  display: block;
  font-size: 26rpx;
  color: #344054;
  line-height: 1.6;
}

.post-expand-btn {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #ff2442;
}

.post-media-grid {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.post-media {
  width: 100%;
  height: 148rpx;
  border-radius: 12rpx;
  background: #f3f4f8;
}

.post-foot {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.post-foot-right {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.post-del-btn {
  height: 50rpx;
  line-height: 50rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
}

.skeleton-line {
  height: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.skeleton-line.lg {
  width: 84%;
}

.skeleton-line {
  width: 96%;
}

.skeleton-line.sm {
  width: 52%;
}
