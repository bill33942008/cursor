.profile-header {
  border-radius: 24rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(20, 31, 56, 0.08);
}

.profile-head {
  display: flex;
  align-items: center;
}

.avatar-image,
.avatar-placeholder {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.avatar-placeholder {
  text-align: center;
  line-height: 86rpx;
  font-size: 34rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff4b66 0%, #ff2442 100%);
}

.profile-main {
  flex: 1;
}

.name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.profile-id {
  margin-top: 10rpx;
}

.summary-row {
  margin-top: 12rpx;
}

.profile-actions {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
}

.timeline-list {
  padding-left: 12rpx;
}

.timeline-item {
  position: relative;
  padding-left: 26rpx;
  margin-bottom: 14rpx;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 20rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff2442;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 34rpx;
  bottom: -14rpx;
  width: 2rpx;
  background: #ffd3db;
}

.timeline-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 31, 56, 0.08);
}

.event-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.event-note {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #475467;
}

.skeleton-line {
  height: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.skeleton-line.lg {
  width: 84%;
}

.skeleton-line {
  width: 96%;
}

.skeleton-line.sm {
  width: 52%;
}
