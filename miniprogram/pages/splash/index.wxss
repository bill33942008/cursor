.splash-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #cde7ff;
}

.splash-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.splash-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(8, 13, 28, 0.04) 30%, rgba(8, 13, 28, 0.6) 100%);
}

.startup-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  padding: 0 20rpx;
}

.hint-text {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #b42318;
  text-align: center;
}

.loading-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff2442;
  animation: pulse 1.1s ease-in-out infinite;
}

.loading-text {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.35);
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.35);
    opacity: 1;
  }
}
