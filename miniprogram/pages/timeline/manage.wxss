.tiny-title {
  margin-bottom: 6rpx;
  font-size: 27rpx;
}

.mini-cancel {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
}

.filter-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.filter-chip {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e4e7ec;
  background: #f8fafc;
  color: #667085;
  font-size: 23rpx;
}

.filter-chip.active {
  border-color: #ffc7d1;
  background: #fff1f4;
  color: #ff2442;
}

.input-box,
.picker-box,
.textarea-box {
  margin-bottom: 14rpx;
}

.media-wrap {
  margin-top: 6rpx;
}

.media-head {
  margin-bottom: 10rpx;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.draft-media-item {
  position: relative;
  width: 100%;
  height: 168rpx;
}

.draft-media {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  background: #f2f4f8;
}

.draft-cover-tag {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 36, 66, 0.9);
  color: #fff;
  font-size: 20rpx;
}

.draft-media-order {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.order-btn {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.58);
  color: #fff;
  text-align: center;
  line-height: 34rpx;
  font-size: 22rpx;
}

.draft-media-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.58);
  color: #fff;
  text-align: center;
  line-height: 34rpx;
  font-size: 24rpx;
}

.media-add {
  height: 168rpx;
  border: 2rpx dashed #e6e8ef;
  border-radius: 14rpx;
  background: #fbfcff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #98a2b3;
}

.media-add-plus {
  font-size: 36rpx;
  line-height: 1;
  color: #667085;
}

.media-add-label {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.event-public {
  margin: 10rpx 0 16rpx;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: #f8f9fc;
}

.save-btn {
  height: 86rpx;
  line-height: 86rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.timeline-list {
  padding-left: 12rpx;
}

.timeline-item {
  position: relative;
  padding-left: 28rpx;
  margin-bottom: 14rpx;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 22rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff2442;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 36rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #ffd3db;
}

.timeline-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(20, 31, 56, 0.08);
}

.event-title {
  font-size: 30rpx;
  font-weight: 700;
}

.event-note {
  margin-top: 8rpx;
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
  color: #475467;
}

.event-media-cover-wrap {
  margin-top: 10rpx;
}

.event-cover-media {
  width: 100%;
  height: 220rpx;
  border-radius: 14rpx;
  background: #f2f4f8;
}

.event-thumb-row {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.event-thumb-item {
  position: relative;
}

.event-thumb-media {
  width: 100%;
  height: 104rpx;
  border-radius: 12rpx;
  background: #f2f4f8;
}

.more-mask {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  top: 0;
  border-radius: 12rpx;
  background: rgba(2, 6, 23, 0.5);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.event-actions {
  margin-top: 10rpx;
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
}

.mini-del {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
}

.skeleton-line {
  height: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.skeleton-line.lg {
  width: 84%;
}

.skeleton-line {
  width: 96%;
}

.skeleton-line.sm {
  width: 52%;
}
