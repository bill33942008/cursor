.tiny-title {
  margin-bottom: 6rpx;
  font-size: 27rpx;
}

.event-public {
  margin: 10rpx 0 16rpx;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: #f8f9fc;
}

.save-btn {
  height: 78rpx;
  line-height: 78rpx;
}

.timeline-list {
  padding-left: 12rpx;
}

.timeline-item {
  position: relative;
  padding-left: 28rpx;
  margin-bottom: 14rpx;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 22rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff2442;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 36rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #ffd3db;
}

.timeline-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(20, 31, 56, 0.08);
}

.event-title {
  font-size: 30rpx;
  font-weight: 700;
}

.event-note {
  margin-top: 8rpx;
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
  color: #475467;
}

.event-actions {
  margin-top: 10rpx;
  display: flex;
  justify-content: flex-end;
}

.mini-del {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
}

.skeleton-line {
  height: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.skeleton-line.lg {
  width: 84%;
}

.skeleton-line {
  width: 96%;
}

.skeleton-line.sm {
  width: 52%;
}
