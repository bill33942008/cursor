.feed-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 32rpx rgba(20, 31, 56, 0.08);
}

.error-card .section-title,
.error-card .subtitle {
  color: #b42318;
}

.feed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.feed-author {
  display: flex;
  align-items: center;
}

.avatar-dot {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: linear-gradient(135deg, #ff6a61 0%, #ff2442 100%);
  box-shadow: 0 8rpx 16rpx rgba(255, 68, 95, 0.3);
}

.feed-user {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.feed-time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.feed-content {
  font-size: 29rpx;
  line-height: 1.8;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.media-cell {
  width: 100%;
  height: 208rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
}

.media-video {
  grid-column: span 3;
  height: 360rpx;
}

.media-single {
  grid-column: span 3;
  height: 420rpx;
}

.feed-tags {
  margin-bottom: 12rpx;
}

.feed-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  border-top: 1rpx solid #f0f2f6;
  padding-top: 12rpx;
}

.action-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #667085;
  padding: 6rpx 0;
}
