.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.wf-col {
  flex: 1;
}

.feed-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 10rpx 32rpx rgba(20, 31, 56, 0.08);
}

.error-card .section-title,
.error-card .subtitle {
  color: #b42318;
}

.feed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.feed-author {
  display: flex;
  align-items: center;
}

.avatar-dot {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: linear-gradient(135deg, #ff6a61 0%, #ff2442 100%);
  box-shadow: 0 8rpx 16rpx rgba(255, 68, 95, 0.3);
}

.feed-user {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: #111827;
}

.feed-time {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.feed-content {
  font-size: 26rpx;
  line-height: 1.65;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.media-cell {
  width: 100%;
  height: 170rpx;
  border-radius: 10rpx;
  background: #f3f4f6;
}

.media-video {
  grid-column: span 2;
  height: 220rpx;
}

.media-single {
  grid-column: span 2;
  height: 280rpx;
}

.feed-tags {
  margin-bottom: 12rpx;
}

.feed-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f2f6;
  padding-top: 10rpx;
}

.action-item {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #667085;
  padding: 6rpx 0;
  border-radius: 999rpx;
}

.comments-box {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #eceff4;
}

.comments-loading,
.comments-empty {
  font-size: 22rpx;
  color: #98a2b3;
  margin-bottom: 8rpx;
}

.comment-row {
  margin-bottom: 8rpx;
  padding: 6rpx 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.comment-main {
  flex: 1;
}

.comment-name {
  color: #344054;
  font-weight: 600;
  margin-right: 8rpx;
}

.comment-content {
  color: #475467;
}

.comment-reply {
  flex: 0 0 auto;
  font-size: 21rpx;
  color: #98a2b3;
}

.reply-list {
  margin-left: 18rpx;
  padding-left: 12rpx;
  border-left: 2rpx solid #f0d4db;
}

.reply-row {
  margin-bottom: 6rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8rpx;
}

.reply-tip {
  margin: 8rpx 0 4rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #fff2f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reply-tip-text {
  font-size: 22rpx;
  color: #b42348;
}

.reply-cancel {
  font-size: 22rpx;
  color: #ff2442;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.comment-input {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e4e7ec;
  background: #f8f9fc;
  font-size: 24rpx;
  padding: 0 16rpx;
}

.comment-send {
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
}

.skeleton-card {
  padding: 16rpx;
}

.skeleton-line {
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.avatar-skeleton {
  width: 70%;
  height: 22rpx;
}

.title-skeleton {
  width: 88%;
  height: 18rpx;
}

.body-skeleton {
  width: 100%;
  height: 16rpx;
}

.body-skeleton.short {
  width: 74%;
}

.skeleton-media {
  height: 190rpx;
  border-radius: 12rpx;
}

.skeleton-media.tall {
  height: 250rpx;
}
