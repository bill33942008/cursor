<view class="page">
  <view class="card">
    <view class="title">在路上广场</view>
    <view class="subtitle">查看路上旅友的实时分享</view>
  </view>

  <view wx:if="{{loading}}" class="card">
    <text>加载中...</text>
  </view>

  <view wx:if="{{error}}" class="card error">
    <text>{{error}}</text>
  </view>

  <block wx:for="{{posts}}" wx:key="id">
    <view class="card">
      <view class="post-head">
        <text class="post-user">{{item.displayName}}</text>
        <text class="post-time">{{item.createdAt}}</text>
      </view>
      <view class="post-content">{{item.content}}</view>
      <view class="post-tags" wx:if="{{item.transportType}}">
        <text class="tag">{{item.transportType}}</text>
        <text class="tag">{{item.origin}} -> {{item.destination}}</text>
      </view>
      <button class="mini-btn" size="mini" data-id="{{item.id}}" bindtap="likePost">
        点赞 {{item.likeCount}}
      </button>
    </view>
  </block>
</view>
