<view class="page-wrap">
  <view class="card">
    <view class="section-title">账号安全</view>
    <text class="subtitle">管理会话状态和本地数据</text>
  </view>

  <view class="card">
    <view class="op-item pressable" hover-class="pressable-hover" bindtap="clearCache">
      <view>
        <text class="op-title">清理本地缓存</text>
        <text class="subtitle">清除本地缓存并重新拉取服务端数据</text>
      </view>
      <text class="op-arrow">›</text>
    </view>

    <view class="op-item danger pressable" hover-class="pressable-hover" bindtap="logout">
      <view>
        <text class="op-title">退出当前账号</text>
        <text class="subtitle">退出后将清空微信资料缓存，下次会重新获取昵称头像</text>
      </view>
      <text class="op-arrow">›</text>
    </view>
  </view>
</view>
