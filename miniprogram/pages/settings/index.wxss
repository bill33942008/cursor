.menu-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.menu-icon {
  width: 44rpx;
  margin-right: 10rpx;
}

.menu-main {
  flex: 1;
}

.menu-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.menu-arrow {
  font-size: 30rpx;
  color: #98a2b3;
}
