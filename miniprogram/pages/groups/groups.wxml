<view class="page-wrap">
  <view class="hero-card">
    <view class="hero-title">同行群组</view>
    <view class="hero-subtitle">按目的地/交通方式快速找到同路旅友</view>
    <view class="hero-pill-row">
      <text class="hero-pill">高铁</text>
      <text class="hero-pill">航班</text>
      <text class="hero-pill">自驾</text>
    </view>
  </view>

  <view class="card filter-card">
    <view class="section-title">搜索群组</view>
    <input class="input-box" placeholder="输入目的地，如 北京 / 上海" placeholder-style="color:#98a2b3;font-size:27rpx;" value="{{destinationKeyword}}" bindinput="onDestinationKeywordInput" />
    <view class="actions-inline">
      <button class="icon-btn" size="mini" bindtap="loadGroups">搜索</button>
      <button class="btn-ghost create-toggle" size="mini" bindtap="toggleCreate">{{creating ? "收起建群" : "我要建群"}}</button>
    </view>
  </view>

  <view class="card create-card" wx:if="{{creating}}">
    <view class="section-title">创建群组</view>
    <input class="input-box" placeholder="群名称（必填）" placeholder-style="color:#98a2b3;font-size:27rpx;" data-key="name" value="{{createForm.name}}" bindinput="onCreateFieldInput" />
    <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="picker-box">群分类：{{categoryOptions[categoryIndex].label}}</view>
    </picker>
    <input class="input-box" placeholder="目的地（可选）" placeholder-style="color:#98a2b3;font-size:27rpx;" data-key="destination" value="{{createForm.destination}}" bindinput="onCreateFieldInput" />
    <input class="input-box" placeholder="航班/车次（可选）" placeholder-style="color:#98a2b3;font-size:27rpx;" data-key="routeCode" value="{{createForm.routeCode}}" bindinput="onCreateFieldInput" />
    <input class="input-box" placeholder="群描述（可选）" placeholder-style="color:#98a2b3;font-size:27rpx;" data-key="description" value="{{createForm.description}}" bindinput="onCreateFieldInput" />
    <button class="btn-primary submit-btn" bindtap="createGroup">发布群组</button>
  </view>

  <view wx:if="{{loading}}" class="card state-card">
    <text class="state-icon">加载中</text>
    <text class="section-title">正在加载群组...</text>
  </view>

  <view wx:if="{{!loading && groups.length === 0}}" class="card state-card">
    <text class="state-icon">暂无</text>
    <text class="section-title">没有找到匹配群组</text>
    <text class="subtitle">试试切换目的地关键词，或自己创建一个</text>
  </view>

  <block wx:for="{{groups}}" wx:key="id">
    <view class="group-card">
      <view class="row-between">
        <text class="group-name">{{item.name}}</text>
        <text class="member-count">{{item.memberCount}} 人</text>
      </view>
      <view class="group-tags">
        <text class="chip">{{item.categoryLabel}}</text>
        <text class="chip">{{item.destination || "未设置目的地"}}</text>
      </view>
      <text class="subtitle owner">群主：{{item.ownerNickname}}</text>
      <view class="group-actions">
        <button class="icon-btn" size="mini" data-id="{{item.id}}" bindtap="joinGroup">加入</button>
        <button class="btn-primary chat-btn" size="mini" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="enterChat">进入聊天</button>
      </view>
    </view>
  </block>
</view>
