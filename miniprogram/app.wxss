page {
  background: #f5f6f9;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.4;
}

view,
text,
button {
  box-sizing: border-box;
}

input,
textarea {
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 400;
}

button::after {
  border: none;
}

.page-wrap {
  padding: 24rpx 24rpx calc(92rpx + env(safe-area-inset-bottom));
}

.hero-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff4b66 0%, #ff4f7a 50%, #ff6b87 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(255, 64, 98, 0.2);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.95;
}

.hero-pill-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  gap: 12rpx;
}

.hero-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 32rpx rgba(20, 31, 56, 0.08);
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.subtitle {
  color: #64748b;
  font-size: 24rpx;
}

.muted {
  color: #94a3b8;
  font-size: 22rpx;
}

.btn-primary {
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff355a 0%, #ff2442 100%);
  color: #fff;
  font-weight: 600;
}

.btn-ghost {
  border: 2rpx solid #ffd2d9;
  border-radius: 999rpx;
  background: #fff6f8;
  color: #ff2442;
  font-weight: 600;
}

.icon-btn {
  border: none;
  border-radius: 999rpx;
  padding: 0 20rpx;
  height: 62rpx;
  line-height: 62rpx;
  font-size: 24rpx;
  background: #fff1f4;
  color: #ff2442;
}

.input-box,
.textarea-box,
.picker-box {
  width: 100%;
  border-radius: 18rpx;
  background: #f8f9fc;
  border: 2rpx solid #edf0f5;
  color: #1f2937;
  font-size: 28rpx;
}

.input-box,
.picker-box {
  min-height: 88rpx;
  padding: 0 20rpx;
}

.textarea-box {
  padding: 20rpx;
  min-height: 220rpx;
  line-height: 1.7;
}

.picker-box {
  display: flex;
  align-items: center;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1f4;
  color: #ff2442;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.state-card {
  text-align: center;
  padding: 42rpx 24rpx;
}

.state-icon {
  display: block;
  font-size: 52rpx;
  margin-bottom: 10rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pressable {
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.pressable-hover {
  transform: scale(0.98);
  opacity: 0.94;
}

.list-appear {
  animation: listFadeInUp 0.36s ease both;
}

@keyframes listFadeInUp {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.skeleton {
  position: relative;
  overflow: hidden;
  background: #eef1f6;
}

.skeleton::after {
  content: "";
  position: absolute;
  left: -180rpx;
  top: 0;
  width: 180rpx;
  height: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0));
  animation: skeletonShimmer 1.25s infinite;
}

@keyframes skeletonShimmer {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(900rpx);
  }
}
