.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(255, 255, 255, 0.98);
  pointer-events: none;
}

.tabbar-inner {
  pointer-events: auto;
  width: 100%;
  margin: 0;
  padding: 2rpx 6rpx calc(2rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -2rpx 12rpx rgba(30, 41, 59, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 2rpx 0 0;
  border-radius: 12rpx;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.tab-item-hover {
  transform: scale(0.96);
}

.icon-box {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto;
}

.tab-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  transition: opacity 0.2s ease, transform 0.26s ease;
}

.line-icon {
  opacity: 1;
}

.fill-icon {
  opacity: 0;
  transform: scale(0.68);
}

.tab-label {
  display: block;
  margin-top: 0;
  font-size: 18rpx;
  color: #98a2b3;
  transition: color 0.2s ease;
}

.active-dot {
  width: 6rpx;
  height: 6rpx;
  margin: 4rpx auto 0;
  border-radius: 50%;
  background: #ff2442;
  opacity: 0;
  transform: translateY(6rpx);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.tab-item.active {
  transform: translateY(-2rpx);
  background: transparent;
}

.tab-item.active .line-icon {
  opacity: 0;
  transform: scale(0.82);
}

.tab-item.active .fill-icon {
  opacity: 1;
  transform: scale(1);
}

.tab-item.active .tab-label {
  color: #ff2442;
  font-weight: 600;
}

.tab-item.active .active-dot {
  opacity: 1;
  transform: translateY(0);
}
