.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: transparent;
  pointer-events: none;
}

.tabbar-inner {
  pointer-events: auto;
  width: 560rpx;
  margin: 0 auto;
  padding: 8rpx 14rpx env(safe-area-inset-bottom);
  border-radius: 24rpx 24rpx 0 0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 22rpx rgba(30, 41, 59, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tab-item {
  flex: 0 0 24%;
  text-align: center;
  padding: 6rpx 0 4rpx;
  border-radius: 20rpx;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.tab-item-hover {
  transform: scale(0.96);
}

.icon-box {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto;
}

.tab-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  transition: opacity 0.2s ease, transform 0.26s ease;
}

.line-icon {
  opacity: 1;
}

.fill-icon {
  opacity: 0;
  transform: scale(0.68);
}

.tab-label {
  display: block;
  margin-top: 2rpx;
  font-size: 19rpx;
  color: #98a2b3;
  transition: color 0.2s ease;
}

.active-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 6rpx auto 0;
  border-radius: 50%;
  background: #ff2442;
  opacity: 0;
  transform: translateY(6rpx);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.tab-item.active {
  transform: translateY(-6rpx);
  background: #fff2f5;
}

.tab-item.active .line-icon {
  opacity: 0;
  transform: scale(0.82);
}

.tab-item.active .fill-icon {
  opacity: 1;
  transform: scale(1);
}

.tab-item.active .tab-label {
  color: #ff2442;
  font-weight: 600;
}

.tab-item.active .active-dot {
  opacity: 1;
  transform: translateY(0);
}
